# Local development: read content from a checkout of the content repo instead of GitHub
CONTENT_DIR=../docs-content

# Production: GitHub account that owns the content repo
CONTENT_REPO_OWNER=
# CONTENT_REPO_NAME=docs-content
# CONTENT_REPO_BRANCH=main

# Fine-grained token with read-only "Contents" access to the content repo (raises the API rate limit)
GITHUB_TOKEN=

# Secret configured in the content repo webhook (POST /api/revalidate)
GITHUB_WEBHOOK_SECRET=
